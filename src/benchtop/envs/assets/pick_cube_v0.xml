<mujoco model="pick_cube-v0">
  <!-- Task scene for pick_cube-v0. The geometry of a released task version is
       immutable: editing anything here changes scores, which means a new task
       version (pick_cube-v1), never a silent edit. -->
  <!-- Resolved from the vendored menagerie directory via an in-memory asset
       map (see envs/pick_cube.py); the path is flat on purpose so that
       panda.xml's own meshdir="assets" resolves. -->
  <include file="panda.xml"/>

  <option timestep="0.002" integrator="implicitfast"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20" offwidth="640" offheight="480"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="table" rgba="0.75 0.72 0.68 1"/>
    <material name="cube" rgba="0.85 0.25 0.2 1"/>
    <material name="target" rgba="0.15 0.6 0.3 0.4"/>
  </asset>

  <worldbody>
    <light pos="0.5 0 2.0" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <geom name="table" type="box" pos="0.5 0 0.2" size="0.35 0.4 0.2" material="table"/>

    <body name="cube" pos="0.45 -0.15 0.425">
      <freejoint name="cube_freejoint"/>
      <inertial pos="0 0 0" mass="0.05" diaginertia="2.08e-5 2.08e-5 2.08e-5"/>
      <geom name="cube" type="box" size="0.025 0.025 0.025" material="cube" friction="1.0 0.05 0.001"
        solref="0.005 1"/>
    </body>

    <body name="target" pos="0.45 0.15 0.401" mocap="true">
      <site name="target" type="cylinder" size="0.03 0.001" material="target"/>
    </body>

    <camera name="eval" pos="1.35 -0.85 1.05" xyaxes="0.55 0.84 0 -0.36 0.24 0.90"/>
  </worldbody>
</mujoco>
